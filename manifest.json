{
  "manifest_version": 2,
  "name": "Copy Link Helper (Firefox)",
  "version": "1.0",
  "description": "Copy selected text or link URL with notifications.",
  "permissions": ["contextMenus", "activeTab", "tabs", "notifications"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_title": "Copy Helper"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-helper@example.com",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}

